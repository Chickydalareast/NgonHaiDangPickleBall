# Copy to .env.production on the VPS and replace every example value.
# Never commit .env.production.
PRODUCTION_DOMAIN=pickleball.example.com
APP_COMMIT_SHA=0000000000000000000000000000000000000000
POSTGRES_DB=nhdp
POSTGRES_USER=nhdp
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
DATABASE_POOL_MAX=3
SESSION_SECRET=replace-with-at-least-32-random-characters
LOG_LEVEL=info
CLOUDINARY_CLOUD_NAME=replace-cloud-name
CLOUDINARY_API_KEY=replace-api-key
CLOUDINARY_API_SECRET=replace-api-secret

# One-time bootstrap only. Keep ALLOW_PRODUCTION_SEED empty during normal deploys.
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_PASSWORD=replace-with-a-strong-admin-password
ALLOW_PRODUCTION_SEED=
